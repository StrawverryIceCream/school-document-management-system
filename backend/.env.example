# Option B: Resend HTTPS API (Port 443, for verified custom domains)
RESEND_API_KEY=

# Option C: Raw SMTP (Local dev or unblocked servers only)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
